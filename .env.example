# Copy to .env and fill in real keys for real provider calls.
# Not required to boot the app - only required when actually calling that provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Used by docker-compose.yml's alertmanager service (Step 16). Optional -
# defaults to the bundled mock Slack receiver if unset, so the demo stack
# works with zero setup. Set this to a real Slack incoming-webhook URL to
# get real Slack notifications instead:
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
